---
const officers = [
  { name: 'Sahas Kumaraguru', role: 'President', img: '/assets/images/officer-sahas.jpg' },
  { name: 'Aidan Yacoob', role: 'Vice President', img: '/assets/images/officer-aidan.jpg' },
  {
    name: 'Abhinav Alwarappan',
    role: 'Head of Technological Management',
    img: '/assets/images/officer-abhinav.jpg',
  },
];
---

<section class="officers section">
  <div class="container">
    <header class="officers__head" data-reveal-group>
      <span class="eyebrow eyebrow--muted reveal">Leadership</span>
      <h2 class="officers__title reveal">Officers</h2>
    </header>

    <div class="officers__grid" data-reveal-group>
      {
        officers.map((person) => (
          <article class="officer reveal" data-cursor>
            <span class="officer__avatar">
              <img src={person.img} alt={`Portrait of ${person.name}`} loading="lazy" width="320" height="320" />
            </span>
            <h3 class="officer__name">{person.name}</h3>
            <p class="officer__role">{person.role}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .officers {
    background: var(--surface);
  }

  .officers__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .officers__title {
    font-size: var(--text-2xl);
  }

  .officers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 0.5rem + 2vw, 2.2rem);
  }

  .officer {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    transition: transform var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
  }

  .officer:hover {
    transform: translateY(-8px);
    border-color: var(--sky);
    box-shadow: var(--shadow-card);
  }

  .officer__avatar {
    width: clamp(120px, 9vw, 160px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.2rem;
    background: var(--surface);
    border: 3px solid var(--white);
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow var(--duration-normal) ease;
  }

  .officer:hover .officer__avatar {
    box-shadow: 0 0 0 2px var(--sky);
  }

  .officer__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .officer__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--navy);
  }

  .officer__role {
    font-size: var(--text-sm);
    color: var(--muted);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .officers__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin-inline: auto;
    }
  }
</style>
