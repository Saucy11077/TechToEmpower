---
import Layout from '../layouts/Layout.astro';

// Square payment link — the donor chooses the amount at checkout.
const DONATE_URL = 'https://square.link/u/AUWq9knP';

const tiers = [
  { amount: '$10', note: 'Buys parts for one student' },
  { amount: '$25', note: 'Funds a week of FIRST training' },
  { amount: '$50', note: 'Ships a 3D printer component' },
  { amount: '$100', note: 'Sponsors a team for one month' },
];
---

<Layout
  title="Donate — Tech To Empower"
  description="Fund real STEM programs. Every dollar goes directly to students. 501(c)(3) — fully tax-deductible."
>
  <section class="donate section">
    <div class="container donate__grid">
      <div class="donate__intro" data-reveal-group>
        <span class="eyebrow eyebrow--muted reveal">Support the mission</span>
        <h1 class="donate__title reveal">Fund real programs</h1>
        <p class="donate__lede reveal">
          Every dollar goes directly to students. 3D printer filament, robot parts, travel
          for a team that couldn&rsquo;t otherwise afford to compete. 501(c)(3) — fully
          tax-deductible.
        </p>
        <p class="donate__proof reveal">
          <span class="donate__proof-dot" aria-hidden="true"></span>
          Join 200+ supporters funding STEM worldwide
        </p>
      </div>

      <div class="donate__card-wrap reveal">
        <div class="donate__beam"></div>
        <div class="donate__card">
          <h2 class="donate__card-title">What your gift can do</h2>

          <ul class="tiers">
            {
              tiers.map((tier) => (
                <li class="tier-card">
                  <span class="tier-card__amount">{tier.amount}</span>
                  <span class="tier-card__note">{tier.note}</span>
                </li>
              ))
            }
          </ul>

          <a
            class="btn donate__submit"
            href={DONATE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="btn__icon" aria-hidden="true">→</span>
            <span>Donate via Square</span>
          </a>

          <p class="donate__fineprint">
            Secure checkout via Square &middot; Tech To Empower is a registered 501(c)(3)
            nonprofit &middot; donations are tax-deductible.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .donate {
    padding-top: calc(76px + var(--space-section));
  }

  .donate__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
  }

  .donate__title {
    font-size: var(--text-hero);
    font-weight: 900;
    margin-top: 1.2rem;
    line-height: 0.98;
  }

  .donate__lede {
    margin-top: 1.6rem;
    max-width: 44ch;
    font-size: var(--text-lg);
    color: var(--muted);
    line-height: 1.55;
  }

  .donate__proof {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--navy-mid);
  }

  .donate__proof-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0 4px var(--sky-soft);
  }

  /* ---- animated conic beam border (navy → sky, no orange) ---- */
  .donate__card-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    padding: 2px;
    isolation: isolate;
  }

  .donate__beam {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: -1;
    overflow: hidden;
  }

  .donate__beam::before {
    content: '';
    position: absolute;
    inset: -50%;
    background: conic-gradient(
      from 0deg,
      var(--navy),
      var(--navy-mid),
      var(--sky),
      var(--navy-mid),
      var(--navy)
    );
    animation: beamSpin 6s linear infinite;
  }

  @keyframes beamSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .donate__card {
    position: relative;
    background: var(--white);
    border-radius: calc(var(--radius-lg) - 2px);
    padding: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
  }

  .donate__card-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 1.4rem;
  }

  .tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tier-card {
    text-align: left;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border);
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tier-card__amount {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--navy);
  }

  .tier-card__note {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.4;
  }

  .donate__submit {
    width: 100%;
    justify-content: center;
    margin-top: 1.5rem;
    font-size: var(--text-base);
  }

  .donate__fineprint {
    margin-top: 1.2rem;
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 880px) {
    .donate__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
</style>
