---
const initiatives = [
  { label: 'STEM in India', href: '/work/help_in_india' },
  { label: 'Neurodiversity in FIRST', href: '/work/neurodiversity_in_first' },
  { label: 'Cultural Fundraising', href: '/work/diwali_fundraising' },
  { label: 'Makerspaces in Jamaica', href: '/work/makerspaces_in_jamaica' },
  { label: 'NEXUS', href: '/work/nexus' },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__mark-row" href="/" aria-label="Tech To Empower — home">
        <span class="footer__mark"><img src="/assets/images/tte-logo.png" alt="" width="40" height="40" /></span>
        <span class="footer__wordmark">Tech To Empower</span>
      </a>
      <p class="footer__tagline">
        501(c)(3) &middot; Est. 2023 &middot; Empowering communities through STEM
      </p>
    </div>

    <nav class="footer__col" aria-label="Initiatives">
      <h3 class="footer__heading">Initiatives</h3>
      {initiatives.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="footer__col" aria-label="Connect">
      <h3 class="footer__heading">Connect</h3>
      <a href="https://instagram.com/tech_to_empower" target="_blank" rel="noopener noreferrer">
        @tech_to_empower
      </a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
  </div>

  <div class="container footer__bar">
    <p>&copy; 2025 Tech To Empower &middot; 501(c)(3) Non-Profit</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: rgba(255, 255, 255, 0.82);
    padding-top: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-bottom: 3.5rem;
  }

  .footer__mark-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--white);
    overflow: hidden;
  }

  .footer__mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--white);
  }

  .footer__tagline {
    margin-top: 1.2rem;
    max-width: 34ch;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 0.4rem;
  }

  .footer__col a {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.78);
    width: fit-content;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .footer__col a:hover {
    color: var(--sky);
    transform: translateX(3px);
  }

  .footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.75rem;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 720px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
