---
const cards = [
  {
    num: '01',
    region: 'India · International',
    title: 'STEM in India',
    desc: 'FIRST robotics in rural Tamil Nadu classrooms that had never seen a robot.',
    img: '/assets/images/card-india.jpg',
    href: '/work/help_in_india',
    area: 'india',
  },
  {
    num: '02',
    region: 'Texas · LISD',
    title: 'Neurodiversity in FIRST',
    desc: 'Making robotics genuinely accessible for neurodiverse students.',
    img: '/assets/images/card-neuro.jpg',
    href: '/work/neurodiversity_in_first',
    area: 'neuro',
  },
  {
    num: '03',
    region: 'DFW · Community',
    title: 'Cultural Fundraising',
    desc: 'Taking the robot everywhere — and letting curiosity do the rest.',
    img: '/assets/images/card-cultural.jpg',
    href: '/work/diwali_fundraising',
    area: 'cultural',
  },
  {
    num: '04',
    region: 'Jamaica · International',
    title: 'Makerspaces in Jamaica',
    desc: 'Four printers. Fifty teams. A fair fight, finally.',
    img: '/assets/images/card-jamaica.jpg',
    href: '/work/makerspaces_in_jamaica',
    area: 'jamaica',
  },
  {
    num: '05',
    region: 'Girls in STEM',
    title: 'NEXUS',
    desc: 'A Girls in STEM program built so girls sit at the center, not the margins.',
    img: '/assets/images/card-nexus.jpg',
    href: '/work/nexus',
    area: 'nexus',
  },
];
---

<section class="bento section" id="work">
  <div class="container">
    <header class="bento__head" data-reveal-group>
      <span class="eyebrow eyebrow--muted reveal">What We Do</span>
      <h2 class="bento__title reveal">Five initiatives. Three continents.</h2>
    </header>

    <div class="bento__grid" data-reveal-group>
      {
        cards.map((card) => (
          <a
            class:list={['bento-card', 'reveal', `bento-card--${card.area}`]}
            href={card.href}
            data-tilt
          >
            <span class="bento-card__media" aria-hidden="true">
              <img src={card.img} alt="" loading="lazy" width="800" height="1000" />
            </span>
            <span class="bento-card__shade" aria-hidden="true" />
            <span class="bento-card__body">
              <span class="bento-card__num">{card.num}</span>
              <span class="bento-card__bottom">
                <span class="bento-card__region">{card.region}</span>
                <span class="bento-card__name">{card.title}</span>
                <span class="bento-card__desc">{card.desc}</span>
                <span class="bento-card__arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bento {
    scroll-margin-top: clamp(5rem, 4rem + 3vw, 7rem);
  }

  .bento__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .bento__title {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .bento__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(2, minmax(248px, 1fr));
    gap: clamp(0.9rem, 0.5rem + 1vw, 1.4rem);
  }

  /* Asymmetric placement — India tall left, NEXUS wide bottom */
  .bento-card--india {
    grid-column: 1 / 5;
    grid-row: 1 / 3;
  }
  .bento-card--neuro {
    grid-column: 5 / 9;
    grid-row: 1;
  }
  .bento-card--cultural {
    grid-column: 9 / 13;
    grid-row: 1;
  }
  .bento-card--jamaica {
    grid-column: 5 / 8;
    grid-row: 2;
  }
  .bento-card--nexus {
    grid-column: 8 / 13;
    grid-row: 2;
  }

  .bento-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--navy);
    min-height: 248px;
    transform-style: preserve-3d;
    transition: transform var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
    will-change: transform;
  }

  .bento-card:hover {
    box-shadow: var(--shadow-float);
  }

  .bento-card__media,
  .bento-card__shade {
    position: absolute;
    inset: 0;
  }

  .bento-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-expo),
      filter var(--duration-normal) ease;
  }

  .bento-card:hover .bento-card__media img {
    transform: scale(1.06);
    filter: brightness(1.08);
  }

  .bento-card__shade {
    background: linear-gradient(
      to top,
      rgba(7, 16, 30, 0.92) 0%,
      rgba(7, 16, 30, 0.35) 45%,
      rgba(7, 16, 30, 0.12) 100%
    );
  }

  .bento-card__body {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: clamp(1.2rem, 0.8rem + 1vw, 1.8rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--white);
    transform: translateZ(40px);
  }

  .bento-card__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sky);
    letter-spacing: 0.05em;
  }

  .bento-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .bento-card__region {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  .bento-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    line-height: 1.05;
  }

  .bento-card__desc {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.78);
    max-width: 34ch;
    line-height: 1.45;
  }

  .bento-card__arrow {
    margin-top: 0.4rem;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--duration-normal) ease, transform var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) ease;
  }

  .bento-card:hover .bento-card__arrow {
    opacity: 1;
    transform: translateX(0);
    background: var(--sky);
    color: var(--navy);
  }

  @media (max-width: 900px) {
    .bento__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
    }
    .bento-card {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    .bento-card--india {
      grid-column: 1 / 3 !important;
    }
    .bento-card--nexus {
      grid-column: 1 / 3 !important;
    }
  }

  @media (max-width: 560px) {
    .bento__grid {
      grid-template-columns: 1fr;
    }
    .bento-card--india,
    .bento-card--nexus {
      grid-column: auto !important;
    }
  }
</style>

<script>
  // 3D tilt tracking cursor position within each card (max ±6deg).
  const MAX = 6;
  const cards = document.querySelectorAll<HTMLElement>('[data-tilt]');
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (fine) {
    cards.forEach((card) => {
      card.style.perspective = '900px';
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `rotateY(${px * MAX}deg) rotateX(${-py * MAX}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>
