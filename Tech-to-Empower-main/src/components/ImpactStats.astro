---
// Aggregate impact band — sits directly under the hero as the second thing
// visitors see, introducing the org's scale before the country-by-country
// tour. Four figures read left to right; each counts up from zero the first
// time the band scrolls into view (reduced-motion users get the final value).
const stats = [
  { value: 100000, prefix: '', suffix: '+', format: 'comma', label: 'People impacted' },
  { value: 40, prefix: '$', suffix: 'k+', format: 'plain', label: 'Raised in funds' },
  { value: 30, prefix: '', suffix: '+', format: 'plain', label: 'Robotics teams started' },
  { value: 20, prefix: '', suffix: '+', format: 'plain', label: 'Makerspaces built' },
];
---

<section class="impact" id="impact" aria-label="Our impact by the numbers">
  <div class="container impact__inner" data-reveal-group>
    <header class="impact__head">
      <span class="eyebrow reveal">By the numbers</span>
      <h2 class="impact__title reveal">Impact that adds up.</h2>
    </header>

    <dl class="impact__grid">
      {
        stats.map((s) => (
          <div class="stat reveal">
            <dt
              class="stat__num"
              data-value={s.value}
              data-prefix={s.prefix}
              data-suffix={s.suffix}
              data-format={s.format}
            >
              {s.prefix}
              {s.format === 'comma' ? s.value.toLocaleString('en-US') : s.value}
              {s.suffix}
            </dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .impact {
    background: var(--navy);
    color: var(--white);
    padding-top: clamp(4.5rem, 3rem + 6vw, 9rem);
    padding-bottom: clamp(2.75rem, 1.75rem + 3vw, 4.5rem);
  }

  .impact__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    text-align: center;
  }

  .impact__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    color: var(--white);
  }

  .impact__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: clamp(1.25rem, 0.3rem + 1.8vw, 2.75rem);
    row-gap: clamp(2rem, 1rem + 2vw, 3rem);
    margin: 0;
  }

  .stat {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: left;
    gap: 0.95rem;
  }

  .stat__num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(4.5rem, 6vw, 6.5rem);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 22px 45px -24px rgba(10, 22, 40, 0.7),
      0 0 0 1px rgba(255, 255, 255, 0.65);
    font-family: var(--font-condensed);
    font-weight: 800;
    /* sized so a number + its inline label fits four-across on one line */
    font-size: clamp(1.7rem, 1.1rem + 1.2vw, 2.2rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--sky);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stat__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    line-height: 1.3;
    text-align: left;
    color: rgba(255, 255, 255, 0.7);
    max-width: 10ch;
  }

  @media (max-width: 960px) {
    .impact__grid {
      justify-content: center;
      column-gap: clamp(2rem, 1rem + 4vw, 4rem);
      row-gap: clamp(2.5rem, 5vw, 3.5rem);
    }
    .stat {
      flex: 0 1 45%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 460px) {
    .stat {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  (function () {
    const section = document.getElementById('impact');
    if (!section) return;

    const nums = Array.from(section.querySelectorAll<HTMLElement>('.stat__num'));
    if (!nums.length) return;

    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const format = (n: number, mode: string | null) =>
      mode === 'comma' ? Math.round(n).toLocaleString('en-US') : String(Math.round(n));

    const render = (el: HTMLElement, n: number) => {
      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';
      el.textContent = prefix + format(n, el.dataset.format ?? 'plain') + suffix;
    };

    // Park every figure at zero up front so the count-up is always visible the
    // first time the band scrolls into view (no flash of the final value).
    if (!prefersReduced) nums.forEach((el) => render(el, 0));

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.value ?? 0);
      if (prefersReduced) {
        render(el, target);
        return;
      }
      const duration = 1600;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        // easeOutExpo
        const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        render(el, target * eased);
        if (p < 1) requestAnimationFrame(tick);
        else render(el, target);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            countUp(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    nums.forEach((el) => io.observe(el));
  })();
</script>
